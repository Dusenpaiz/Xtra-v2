--========================================================
-- DRAG
--========================================================

local dragging = false
local dragStart
local startPos

local function updateButton(input)

    local delta =
        input.Position - dragStart

    HopButton.Position =
        UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,

            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )

    Status.Position =
        UDim2.new(
            HopButton.Position.X.Scale,
            HopButton.Position.X.Offset - 190,

            HopButton.Position.Y.Scale,
            HopButton.Position.Y.Offset + 47
        )

end

HopButton.InputBegan:Connect(function(input)

    if input.UserInputType ==
        Enum.UserInputType.MouseButton1

        or input.UserInputType ==
        Enum.UserInputType.Touch then

        dragging = true

        dragStart = input.Position
        startPos = HopButton.Position

        input.Changed:Connect(function()

            if input.UserInputState ==
                Enum.UserInputState.End then

                dragging = false

            end

        end)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if not dragging then
        return
    end

    if input.UserInputType ==
        Enum.UserInputType.MouseMovement

        or input.UserInputType ==
        Enum.UserInputType.Touch then

        updateButton(input)

    end

end)

--========================================================
-- GET SERVERS
--========================================================

local function GetServers()

    local servers = {}

    local cursor = ""

    for page = 1, MAX_PAGES do

        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(TARGET_PLACE_ID)
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor ~= "" then

            url =
                url
                .. "&cursor="
                .. HttpService:UrlEncode(cursor)

        end

        local success, response =
            pcall(function()

                return game:HttpGet(url)

            end)

        if not success then

            warn(
                "[ServerHop] HTTP failed:",
                response
            )

            break

        end

        local ok, data =
            pcall(function()

                return HttpService:JSONDecode(response)

            end)

        if not ok or not data then

            warn(
                "[ServerHop] JSON decode failed"
            )

            break

        end

        if data.data then

            for _, server in ipairs(data.data) do

                local current = false
                local previous = false

                -- Nếu hiện tại đang ở Target Place
                if game.PlaceId == TARGET_PLACE_ID then

                    if server.id == game.JobId then
                        current = true
                    end

                end

                -- Server trước đó
                if LastServer
                and LastServer.placeId == TARGET_PLACE_ID
                and LastServer.id == server.id then

                    previous = true

                end

                if server.id
                and not current
                and not previous

                and server.playing
                and server.playing >= MIN_PLAYERS
                and server.playing <= MAX_PLAYERS

                and server.maxPlayers
                and server.playing < server.maxPlayers then

                    table.insert(
                        servers,
                        server
                    )

                end

            end

        end

        cursor =
            data.nextPageCursor or ""

        if cursor == "" then
            break
        end

        task.wait(0.12)

    end

    return servers

end

--========================================================
-- SORT
--========================================================

local function SortServers(servers)

    local result = {}

    for _, wantedPlayers in ipairs(PRIORITY) do

        for _, server in ipairs(servers) do

            if server.playing ==
                wantedPlayers then

                table.insert(
                    result,
                    server
                )

            end

        end

    end

    return result

end

--========================================================
-- TELEPORT FAILED
--========================================================

local teleportFailed = false
local teleportFailureReason = ""
local teleportTargetId = nil

TeleportService.TeleportInitFailed:Connect(
    function(
        player,
        result,
        message,
        placeId,
        instanceId
    )

        if player ~= LocalPlayer then
            return
        end

        if placeId ~= TARGET_PLACE_ID then
            return
        end

        if teleportTargetId
        and instanceId
        and instanceId ~= teleportTargetId then

            return

        end

        teleportFailed = true

        teleportFailureReason =
            tostring(result)
            .. " - "
            .. tostring(message)

        warn(
            "[ServerHop] Teleport failed:",
            teleportFailureReason
        )

    end
)

--========================================================
-- HOP
--========================================================

local hopping = false

local function ServerHop()

    if hopping then
        return
    end

    hopping = true

    HopButton.Active = false
    HopButton.Text = "Searching..."

    Status.Text =
        "Finding Target servers..."

    local servers =
        GetServers()

    if #servers == 0 then

        Status.Text =
            "No server, retrying..."

        task.wait(RETRY_DELAY)

        hopping = false

        task.spawn(ServerHop)

        return

    end

    local sorted =
        SortServers(servers)

    local attempts =
        math.min(
            #sorted,
            MAX_ATTEMPTS
        )

    Status.Text =
        "Found "
        .. tostring(#sorted)
        .. " servers"

    task.wait(0.3)

    for i = 1, attempts do

        local target =
            sorted[i]

        if not target then
            break
        end

        teleportFailed = false
        teleportFailureReason = ""
        teleportTargetId = target.id

        Status.Text =
            "Trying "
            .. tostring(i)
            .. "/"
            .. tostring(attempts)
            .. " - "
            .. tostring(target.playing)
            .. " players"

        HopButton.Text =
            "Teleport..."

        print(
            "[ServerHop] Target:",
            target.id,
            target.playing,
            "players"
        )

        local success, err =
            pcall(function()

                TeleportService:TeleportToPlaceInstance(
                    TARGET_PLACE_ID,
                    target.id,
                    LocalPlayer,
                    {
                        lastServer = {
                            id = target.id,
                            placeId = TARGET_PLACE_ID
                        },

                        targetPlaceId =
                            TARGET_PLACE_ID,

                        returnToTarget = true
                    }
                )

            end)

        if not success then

            warn(
                "[ServerHop] Teleport error:",
                err
            )

            Status.Text =
                "Failed, next..."

            task.wait(0.5)

        else

            local start =
                os.clock()

            while
                os.clock() - start
                < TELEPORT_TIMEOUT

            do

                if teleportFailed then
                    break
                end

                task.wait(0.1)

            end

            if teleportFailed then

                Status.Text =
                    "Server failed, next..."

            else

                Status.Text =
                    "Teleport timeout..."

            end

            task.wait(0.5)

        end

        teleportTargetId = nil

    end

    Status.Text =
        "All failed, rescanning..."

    HopButton.Text =
        "Searching..."

    task.wait(RETRY_DELAY)

    hopping = false

    task.spawn(ServerHop)

end

--========================================================
-- AUTO RETURN
--========================================================
-- Nếu script khởi chạy ở Place khác,
-- tự động quay lại Target Place.

local function AutoReturnToTarget()

    if game.PlaceId == TARGET_PLACE_ID then

        return

    end

    -- Chỉ tự quay lại nếu TeleportData
    -- cho biết chúng ta đang muốn ở Target Place.

    if TeleportData
    and TeleportData.returnToTarget
    and TeleportData.targetPlaceId ==
        TARGET_PLACE_ID then

        Status.Text =
            "Redirected! Returning..."

        HopButton.Text =
            "Returning..."

        task.wait(1)

        pcall(function()

            TeleportService:Teleport(
                TARGET_PLACE_ID,
                LocalPlayer
            )

        end)

    end

end

